    <diagram id="matlab-analysis" name="MATLAB Analysis">
        <mxGraphModel dx="2198" dy="733" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="matlab/ 主分析链：加载、总览、PRN 捕获、多星扫描、归档" style="text;html=1;fontStyle=1;fontSize=22;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="cfg" value="run_capture_analysis(stem_or_json_path, cfg)&#xa;build_default_cfg()&#xa;默认 noncoherent_ms=10, Doppler ±10 kHz, step=500 Hz" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C79A2E;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#3A2F00;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="710" y="80" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="resolve" value="&lt;b&gt;辅助函数&lt;br&gt;gnss_rx_resolve_data_dir()&lt;br&gt;find_latest_capture()&lt;br&gt;gnss_rx_resolve_accel_options()&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B87C5;strokeWidth=2;fontSize=13;fontColor=#1F2937;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="710" y="230" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="load" value="load_gnss_rx_capture()&#xa;支持 stem / .json / .sc16 输入&#xa;jsondecode sidecar + 读 SC16 little-endian&#xa;→ samples / meta / paths" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B87C5;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#1F2937;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="710" y="380" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="overview" value="plot_capture_overview()&#xa;overview_time / overview_spectrum / iq_scatter" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B87C5;strokeWidth=2;fontSize=13;fontColor=#1F2937;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="190" y="540" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="prn_group_bg" value="PRN Replica &amp; 相关捕获" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F2FF;strokeColor=#8A63A8;strokeWidth=2;fontColor=#6D4B8A;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=10;connectable=0;" parent="1" vertex="1">
                    <mxGeometry x="700" y="530" width="380" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="ca" value="本地 PRN replica&#xa;generate_ca_code()&#xa;build_sampled_ca_code()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#6B7280;strokeWidth=2;fontSize=13;fontColor=#1F2937;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="750" y="560" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="acq" value="run_prn_acquisition(samples, meta, cfg)&#xa;目标 PRN = meta.prn_id&#xa;样本按 1 ms reshape&#xa;FFT 循环相关 + 非相干累加&#xa;backend: cpu / parfor / gpu" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EADCF2;strokeColor=#8A63A8;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#2E2140;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="750" y="710" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="acq_timing_note" value="&lt;b&gt;参数说明&lt;br&gt;FFT 循环相关（相干）：1 ms / 次&lt;br&gt;非相干累加：默认 10 ms = 10 × 1 ms&lt;br&gt;可由 cfg.noncoherent_ms 调整&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C79A2E;strokeWidth=2;fontSize=12;fontColor=#3A2F00;spacing=8;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="715" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="acq_out" value="acq_result&#xa;detected / peak_metric / second_peak_ratio&#xa;best_doppler_hz / best_code_phase_samples" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DDEEDB;strokeColor=#6FA04F;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#1F3B16;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="750" y="900" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="survey" value="run_multi_prn_survey(samples, meta, cfg)&#xa;默认 PRN 1:32&#xa;CPU/parfor 路径共享载波矩阵&#xa;GPU 路径循环复用 run_prn_acquisition()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EADCF2;strokeColor=#8A63A8;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#2E2140;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="540" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="survey_plot" value="plot_multi_prn_survey()&#xa;次峰比柱状图 + 阈值线" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EADCF2;strokeColor=#8A63A8;strokeWidth=2;fontSize=13;fontColor=#2E2140;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="710" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="save" value="save_analysis_artifacts(meta, paths, figures, acq_result, cfg)&#xa;保存 overview / acquisition / summary&#xa;run_capture_analysis 额外写 multi_prn_survey.png" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EADCF2;strokeColor=#8A63A8;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#2E2140;spacing=8;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="560" y="1070" width="680" height="90" as="geometry"/>
