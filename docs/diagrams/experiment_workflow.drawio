<mxfile host="app.diagrams.net" modified="2026-04-08T00:00:00.000Z" agent="Claude" version="24.7.17">
  <diagram id="experiment-workflow" name="实验工作流">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="GNSS TX/RX 实验工作流（Experiment Workflow）" style="text;html=1;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="1200" height="35" as="geometry"/>
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="开始实验" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82B366;strokeColor=#5A8040;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="65" width="140" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 1: Select config -->
        <mxCell id="step_cfg" value="选择配置文件&#xa;TX: 6 种配置 (tx_b210*.yaml)&#xa;RX: 5 种配置 (rx_*.yaml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="155" width="300" height="80" as="geometry"/>
        </mxCell>

        <!-- Step 2: Dry run -->
        <mxCell id="step_dryrun" value="运行 --dry-run 验证&#xa;检查配置参数合法性&#xa;无需硬件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="275" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Decision: config ok? -->
        <mxCell id="dec_cfg" value="配置正确？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="390" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Fix config -->
        <mxCell id="fix_cfg" value="修改 YAML 配置&#xa;调整参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="398" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- Decision: hardware available? -->
        <mxCell id="dec_hw" value="USRP 硬件&#xa;可用？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="520" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- Synthetic path -->
        <mxCell id="step_synth" value="gen_synthetic_capture.py&#xa;软件仿真（无硬件）&#xa;--snr-db / --duration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontStyle=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="530" width="270" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="note_synth" value="复用 gnss_tx 模块&#xa;生成 clean signal + AWGN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFACD;strokeColor=#D6B656;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="615" width="250" height="40" as="geometry"/>
        </mxCell>

        <!-- TX/RX sync execution -->
        <mxCell id="step_txrx_box" value="TX / RX 同步执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="530" y="665" width="440" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="step_tx" value="TX: run_tx.py&#xa;发射 GPS L1 C/A 信号&#xa;USRP B210 TX/RX 端口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="545" y="700" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step_rx" value="RX: record_rx.py&#xa;采集 IQ 样本存盘&#xa;USRP B210 RX2 端口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="700" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rf_link" value="RF 链路&#xa;有线回环 / OTA" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="625" y="800" width="165" height="55" as="geometry"/>
        </mxCell>

        <!-- Output files -->
        <mxCell id="step_output" value="采集输出&#xa;.sc16 IQ 数据 + .json 元数据&#xa;路径: results/YYYY_MM_DD/..." style="shape=document;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="920" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- MATLAB analysis block -->
        <mxCell id="matlab_box" value="MATLAB 离线分析（run_capture_analysis.m）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE8F5;strokeColor=#9673A6;fontStyle=1;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="1060" width="620" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="matlab_acq" value="PRN 捕获&#xa;码相位搜索&#xa;多普勒频偏估计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="1095" width="165" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="matlab_track" value="DLL/PLL 跟踪&#xa;码/载波同步&#xa;导航比特恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="665" y="1095" width="165" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="matlab_ber" value="BER 评估&#xa;与 TX truth 比对&#xa;可视化 + 报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#7050A0;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="1095" width="165" height="80" as="geometry"/>
        </mxCell>

        <!-- Decision: results OK? -->
        <mxCell id="dec_result" value="结果满足&#xa;要求？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="1310" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Adjust parameters -->
        <mxCell id="step_adjust" value="调整参数&#xa;SNR / 增益 / 频偏&#xa;PRN 选择 / 采样率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1318" width="220" height="65" as="geometry"/>
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="实验完成&#xa;归档数据" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82B366;strokeColor=#5A8040;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="1430" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="step_cfg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="step_cfg" target="step_dryrun">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="step_dryrun" target="dec_cfg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- dec_cfg → fix -->
        <mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#B85450;fontStyle=1;" edge="1" parent="1" source="dec_cfg" target="fix_cfg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- fix → cfg -->
        <mxCell id="e4b" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="1" source="fix_cfg" target="step_cfg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="217"/>
              <mxPoint x="750" y="217"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- dec_cfg → dec_hw -->
        <mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#82B366;fontStyle=1;" edge="1" parent="1" source="dec_cfg" target="dec_hw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- dec_hw → synth (No) -->
        <mxCell id="e6" value="否（仿真）" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#D6B656;fontStyle=1;" edge="1" parent="1" source="dec_hw" target="step_synth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- synth → output -->
        <mxCell id="e6b" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="1" source="step_synth" target="step_output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="375" y="960"/>
              <mxPoint x="610" y="960"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- dec_hw → TX/RX (Yes) -->
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#82B366;fontStyle=1;" edge="1" parent="1" source="dec_hw" target="step_txrx_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- TX/RX → output -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="step_txrx_box" target="step_output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- output → matlab -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="step_output" target="matlab_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- matlab internal -->
        <mxCell id="em1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="1" source="matlab_acq" target="matlab_track">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="em2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="1" source="matlab_track" target="matlab_ber">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- matlab → decision -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="matlab_box" target="dec_result">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- decision → adjust (No) -->
        <mxCell id="e11" value="否&#xa;调整参数" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#B85450;fontStyle=1;" edge="1" parent="1" source="dec_result" target="step_adjust">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- adjust → cfg (loop back) -->
        <mxCell id="e11b" value="重新实验" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#B85450;fontStyle=1;fontSize=10;" edge="1" parent="1" source="step_adjust" target="step_cfg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1220" y="1350"/>
              <mxPoint x="1220" y="195"/>
              <mxPoint x="750" y="195"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- decision → end (Yes) -->
        <mxCell id="e12" value="是" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#82B366;fontStyle=1;" edge="1" parent="1" source="dec_result" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- TX/RX sync arrow between step_tx and step_rx -->
        <mxCell id="e_sync" value="同步" style="endArrow=none;startArrow=none;dashed=1;strokeColor=#D79B00;strokeWidth=2;fontStyle=1;fontSize=10;" edge="1" parent="1" source="step_tx" target="step_rx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sidebar notes -->
        <mxCell id="note1" value="TX 配置 6 种：&#xa;• tx_b210.yaml（基线）&#xa;• tx_b210_visible_spectrum.yaml&#xa;• tx_b210_sn8003272.yaml&#xa;• tx_b210_all32prn.yaml&#xa;• tx_b210_prn_subset.yaml&#xa;• tx_b210_cable_loopback.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="250" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="RX 配置 5 种：&#xa;• rx_prn1_capture.yaml&#xa;• rx_prn1_sn193982.yaml&#xa;• rx_all32prn.yaml&#xa;• rx_cable_loopback.yaml&#xa;• rx_baremetal.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FAF0;strokeColor=#82B366;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1280" y="155" width="250" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="note3" value="MATLAB 分析入口：&#xa;matlab/scripts/run_capture_analysis.m&#xa;输入: .sc16 + .json&#xa;输出: 捕获报告 / BER 曲线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEF8;strokeColor=#9673A6;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1095" width="240" height="90" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
