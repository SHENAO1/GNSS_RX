          <mxGeometry x="670" y="248" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="rx-sc16-sink" value="Sc16CaptureSink (gr.sync_block)&#xa;writer.py&#xa;complex_to_sc16_interleaved()&#xa;流式写 .sc16 (int16 IQ interleaved LE)"
