                vertex="1" parent="1">
          <mxGeometry x="640" y="20" width="380" height="1060" as="geometry"/>
        </mxCell>

        <!-- MATLAB Analysis background -->
        <mxCell id="lane-matlab-bg" value="MATLAB 离线分析链"
