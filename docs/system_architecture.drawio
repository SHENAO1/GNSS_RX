                vertex="1" parent="1">
          <mxGeometry x="670" y="635" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== MATLAB ANALYSIS ===== -->
        <mxCell id="mat-entry" value="run_capture_analysis.m (主入口)&#xa;matlab/scripts/run_capture_analysis.m&#xa;gnss_rx_resolve_data_dir()&#xa;find_latest_capture() — 自动找最新文件"
