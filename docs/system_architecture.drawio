<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-03-26" version="21.0.0">
  <diagram id="gnss-sdr-system" name="GNSS SDR System Architecture">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="1"
                  pageScale="1" pageWidth="1900" pageHeight="1300"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TX Lane background -->
        <mxCell id="lane-tx-bg" value="TX 链路 (gnss_tx / Python + GNU Radio)"
