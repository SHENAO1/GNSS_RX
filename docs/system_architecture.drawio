        </mxCell>

        <mxCell id="rx-synthetic" value="[合成数据旁路 — 无硬件]&#xa;gen_synthetic_capture.py&#xa;GpsL1CaBpskGenerator / build_multi_sat_replay_samples()&#xa;→ _add_awgn(snr_db) → write_sc16_file()&#xa;文件名含 '_synthetic' 标签"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;dashed=1;fontSize=10;strokeWidth=2;"
