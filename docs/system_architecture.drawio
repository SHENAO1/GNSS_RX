          <mxGeometry x="455" y="660" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== RX CHAIN ===== -->
        <mxCell id="rx-config" value="YAML Config → RxRuntimeConfig&#xa;configs/rx_*.yaml — runtime.py"
