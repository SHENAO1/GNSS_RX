          <mxGeometry x="670" y="335" width="300" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="rx-files" value=".sc16 数据文件 + .json 元数据&#xa;metadata.py / CaptureMetadata&#xa;{sample_rate, center_freq, prn_id, layout...}"
