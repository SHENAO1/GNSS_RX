          <mxGeometry x="1080" y="175" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mat-ca-local" value="本地 C/A 码 replica 生成&#xa;generate_ca_code() [MATLAB 内嵌]&#xa;重采样 → FFT 域循环相关"
