                vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="380" height="1060" as="geometry"/>
        </mxCell>

        <!-- RF Channel background -->
        <mxCell id="lane-rf-bg" value="RF 信道"
                style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;align=center;"
