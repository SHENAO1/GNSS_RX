                vertex="1" parent="1">
          <mxGeometry x="1430" y="265" width="300" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="mat-acq" value="run_prn_acquisition(samples, meta, cfg)&#xa;matlab/functions/run_prn_acquisition.m&#xa;二维搜索：Doppler × 码相位&#xa;Doppler: ±10 kHz, step 500 Hz&#xa;码相位: 0~1022 chips&#xa;非相干累加: 10 ms, FFT 循环相关"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="1080" y="265" width="300" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="mat-decision" value="捕获判决&#xa;次峰比 ≥ 2.5 → detected=true&#xa;acq_result: {doppler_hz, code_phase}"
