                vertex="1" parent="1">
          <mxGeometry x="1080" y="400" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mat-survey" value="run_multi_prn_survey()&#xa;matlab/functions/run_multi_prn_survey.m&#xa;PRN 1~32 批量扫描&#xa;返回次峰比数组 + detected 向量"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="1080" y="520" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="mat-plot-survey" value="plot_multi_prn_survey()&#xa;PRN 次峰比柱状图（哪些星被捕获）"
