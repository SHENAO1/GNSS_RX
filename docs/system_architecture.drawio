          <mxGeometry x="420" y="20" width="200" height="1060" as="geometry"/>
        </mxCell>

        <!-- RX Lane background -->
        <mxCell id="lane-rx-bg" value="RX 链路 (GNSS_RX / Python + GNU Radio)"
