                vertex="1" parent="1">
          <mxGeometry x="670" y="65" width="300" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="rx-usrp" value="uhd.usrp_source (USRP B210)&#xa;flowgraph.py / create_usrp_source()&#xa;fc32 CPU, sc16 OTW&#xa;center_freq: 100 MHz, 4.092 MSPS"
                style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;"
