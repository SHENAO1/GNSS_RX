                vertex="1" parent="1">
          <mxGeometry x="1080" y="620" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mat-save" value="save_analysis_artifacts()&#xa;matlab/functions/save_analysis_artifacts.m&#xa;PNG + JSON summary + MAT&#xa;→ analysis/&lt;stem&gt;/"
