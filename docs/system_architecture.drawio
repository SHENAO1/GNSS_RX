                vertex="1" parent="1">
          <mxGeometry x="1040" y="20" width="840" height="1060" as="geometry"/>
        </mxCell>

        <!-- ===== TX CHAIN ===== -->
        <mxCell id="tx-config" value="YAML Config + PRN ID (1~32)&#xa;configs/tx_b210*.yaml"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="65" width="300" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="tx-prn-gen" value="generate_ca_code(prn_id)&#xa;ca/prn_generator.py&#xa;G1/G2 LFSR 生成 C/A 码"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="lbl-ca" value="np.int8[1023]  {-1, +1}"
                style="text;html=1;fontSize=9;fontColor=#888888;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="110" y="220" width="200" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="tx-nav" value="CyclicNavBitSource / normalize_nav_bits()&#xa;nav/nav_bits.py&#xa;50 bps 循环导航 bit {-1,+1}"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="245" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="tx-spread" value="GpsL1CaBpskGenerator.generate_samples()&#xa;signal/spreader.py&#xa;spread chip = CA × NavBit"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="tx-resamp" value="repeat_chips(spc=4) — ca/resampler.py&#xa;零阶保持上采样"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="425" width="190" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="tx-iq" value="chips_to_complex_baseband()&#xa;signal/iq_builder.py&#xa;BPSK → complex64, Q=0"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="485" width="300" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="lbl-iq" value="np.complex64 baseband (振幅 ~1.0 per PRN)"
                style="text;html=1;fontSize=9;fontColor=#888888;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="545" width="300" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="tx-multisat" value="[多星模式] build_multi_sat_replay_samples()&#xa;signal/multi_sat_combiner.py&#xa;PRN1~32 线性叠加 ÷√32 归一化"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=2;fontSize=10;dashed=1;strokeWidth=2;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="568" width="300" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="lbl-combined" value="np.complex64 归一化合并基带"
                style="text;html=1;fontSize=9;fontColor=#888888;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="638" width="300" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="tx-gr-src" value="blocks.vector_source_c(repeat=True)&#xa;gr/top_block.py — GpsL1CaTxTopBlock&#xa;预生成缓冲区循环回放"
                style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="tx-amp" value="blocks.multiply_const_cc(amplitude=0.25)&#xa;gr/top_block.py — 幅度缩放 gr_complex 流"
                style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="750" width="300" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="tx-usrp" value="uhd.usrp_sink (USRP B210)&#xa;usrp/b210_sink.py&#xa;fc32→sc16 OTW, 4.092 MSPS&#xa;center_freq: 100 MHz"
                style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;"
