        <mxCell id="leg5" value="MATLAB 分析" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1445" y="590" width="200" height="28" as="geometry"/></mxCell>
