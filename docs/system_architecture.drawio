          <mxGeometry x="160" y="1000" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== RF CHANNEL ===== -->
        <mxCell id="rf-air" value="自由空间传播&#xa;RF 信号 @ 100 MHz&#xa;(实验室近场)&#xa;路径损耗 ~30 dB"
                style="ellipse;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="445" y="440" width="160" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="lbl-rf" value="GPS L1 C/A 兼容格式&#xa;BPSK(1), 2.046 MHz 双边带&#xa;码率 1.023 Mcps"
