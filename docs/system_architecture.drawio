          <mxGeometry x="60" y="835" width="300" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="tx-unimpl" value="[未实现占位符]&#xa;nav/subframe_builder.py&#xa;utils/timebase.py / utils/logging.py"
