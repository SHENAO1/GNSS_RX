                <mxCell id="dep1" value="run_prn1_acquisition(samples, meta, cfg)&#xa;↳ thin wrapper → run_prn_acquisition(prn_id=1)&#xa;(deprecated, 仅保留向后兼容)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#999999;dashed=1;fontSize=10;" parent="1" vertex="1">
