<mxfile host="65bd71144e">
    <diagram id="matlab-analysis" name="MATLAB Analysis">
        <mxGraphModel dx="1977" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="matlab/ 主分析链：加载、总览、PRN 捕获、多星扫描、归档" style="text;html=1;fontStyle=1;fontSize=18;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="20" width="1160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="cfg" value="run_capture_analysis(stem_or_json_path, cfg)&#xa;build_default_cfg()&#xa;默认 noncoherent_ms=10, Doppler ±10 kHz, step=500 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1">
                    <mxGeometry x="80" y="110" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="resolve" value="辅助函数&#xa;gnss_rx_resolve_data_dir()&#xa;find_latest_capture()&#xa;gnss_rx_resolve_accel_options()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="420" y="115" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="load" value="load_gnss_rx_capture()&#xa;支持 stem / .json / .sc16 输入&#xa;jsondecode sidecar + 读 SC16 little-endian&#xa;→ samples / meta / paths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="760" y="117.5" width="300" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="overview" value="plot_capture_overview()&#xa;overview_time / overview_spectrum / iq_scatter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="120" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ca" value="本地 PRN replica&#xa;generate_ca_code()&#xa;build_sampled_ca_code()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="830" y="530" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="acq" value="run_prn_acquisition(samples, meta, cfg)&#xa;目标 PRN = meta.prn_id&#xa;样本按 1 ms reshape&#xa;FFT 循环相关 + 非相干累加&#xa;backend: cpu / parfor / gpu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1">
                    <mxGeometry x="960" y="270" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="acq_out" value="acq_result&#xa;detected / peak_metric / second_peak_ratio&#xa;best_doppler_hz / best_code_phase_samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1">
                    <mxGeometry x="1660" y="290" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="survey" value="run_multi_prn_survey(samples, meta, cfg)&#xa;默认 PRN 1:32&#xa;CPU/parfor 路径共享载波矩阵&#xa;GPU 路径循环复用 run_prn_acquisition()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1">
                    <mxGeometry x="480" y="650" width="360" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="survey_plot" value="plot_multi_prn_survey()&#xa;次峰比柱状图 + 阈值线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1">
                    <mxGeometry x="1660" y="490" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="save" value="save_analysis_artifacts(meta, paths, figures, acq_result, cfg)&#xa;保存 overview / acquisition / summary&#xa;run_capture_analysis 额外写 multi_prn_survey.png" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1">
                    <mxGeometry x="930" y="830" width="600" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="out" value="analysis/&lt;stem&gt;/&#xa;overview_time.png&#xa;overview_spectrum.png&#xa;iq_scatter.png&#xa;prn1_acquisition.png&#xa;multi_prn_survey.png&#xa;analysis_summary.json / .mat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1">
                    <mxGeometry x="1660" y="820" width="250" height="120" as="geometry"/>
