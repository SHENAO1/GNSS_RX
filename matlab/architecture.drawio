    <diagram id="matlab-module" name="matlab/ — MATLAB 离线分析模块">
        <mxGraphModel dx="3332" dy="1668" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="matlab/ — MATLAB 离线分析模块 (run_capture_analysis + 信号捕获链)" style="text;html=1;fontStyle=1;fontSize=14;align=center;" parent="1" vertex="1">
                    <mxGeometry x="50" y="10" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="entry" value="入口: run_capture_analysis(stem_or_json_path, cfg)" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="440" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="resolve-dir" value="gnss_rx_resolve_data_dir() → str&#xa;从环境变量或默认路径定位数据根目录" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="145" width="440" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="find-latest" value="find_latest_capture(root) → json_path&#xa;按时间戳自动找最新 .json 捕获文件" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="235" width="440" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="load-cap" value="load_gnss_rx_capture(json_path)&#xa;  读 .json → meta struct (jsondecode)&#xa;  读 .sc16 → int16[2N] → complex[N×1] double&#xa;→ (samples, meta, paths)" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="325" width="440" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="in-types" value="samples: complex[N×1] double&#xa;meta: struct {center_freq, sample_rate, duration_s, samples_captured, prn_id, ...}&#xa;paths: struct {json_path, sc16_path, stem}" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="-360" y="463" width="440" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="plot-overview" value="plot_capture_overview(samples, meta, paths, cfg)&#xa;  ① 时域波形（前 10 ms）&#xa;  ② 65536 pt FFT 功率谱密度&#xa;  ③ IQ 散点图&#xa;→ figures struct" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="590" width="440" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="ca-replica" value="[本地 C/A replica 生成]&#xa;generate_ca_code(prn_id)  [MATLAB 内嵌 LFSR 实现]&#xa;np.repeat(ca_code, samples_per_chip) → 重采样到目标采样率" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="-360" y="740" width="440" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="acquisition" value="run_prn_acquisition(samples, meta, cfg)&#xa;  2D 搜索: Doppler [-10k, +10k] Hz, step=500 Hz&#xa;           码相位 [0, 1022] chips&#xa;  每个 (Doppler, phase): FFT 循环相关&#xa;  非相干累加: 10 ms&#xa;  次峰比 ≥ 2.5 → detected = true&#xa;→ acq_result struct" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="-360" y="877.5" width="440" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="acq-out" value="acq_result: struct&#xa;  detected: bool&#xa;  doppler_hz: float&#xa;  code_phase_samples: int&#xa;  peak_ratio: float" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="-360" y="1120" width="440" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="survey" value="run_multi_prn_survey(samples, meta, cfg)&#xa;  for PRN 1~32: run_prn_acquisition(prn_id=k)&#xa;→ survey struct" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="530" y="737.5" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="survey-out" value="survey: struct&#xa;  prn_ids: int[32]&#xa;  peak_ratios: float[32]&#xa;  detected: bool[32]" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="530" y="900" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="plot-survey" value="plot_multi_prn_survey(survey, paths, cfg)&#xa;  次峰比柱状图（PRN 1~32）&#xa;  检测阈值横线 (2.5)&#xa;→ fig handle" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="530" y="1125" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="save" value="save_analysis_artifacts(meta, paths, figures, acq_result, cfg)&#xa;  PNG 图像 → analysis/&lt;stem&gt;/&#xa;  JSON 结果 → analysis/&lt;stem&gt;/result.json&#xa;  MAT 文件 → analysis/&lt;stem&gt;/workspace.mat&#xa;→ save_info struct" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="-150" y="1320" width="880" height="100" as="geometry"/>
                </mxCell>
