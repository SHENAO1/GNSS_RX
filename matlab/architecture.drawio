                <mxCell id="deprecated" value="兼容包装&#xa;run_prn1_acquisition()&#xa;内部只是在 meta 上强制 prn_id=1 后转调 run_prn_acquisition()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#999999;dashed=1;" parent="1" vertex="1">
