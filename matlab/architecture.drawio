<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-03-26" version="21.0.0">
  <diagram id="matlab-module" name="matlab/ — MATLAB 离线分析模块">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="1"
                  pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="matlab/ — MATLAB 离线分析模块 (run_capture_analysis + 信号捕获链)"
                style="text;html=1;fontStyle=1;fontSize=14;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="50" y="10" width="1300" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== MAIN CHAIN (Center-Left Column) ===== -->
        <mxCell id="entry" value="入口: run_capture_analysis(stem_or_json_path, cfg)"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="440" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="resolve-dir" value="gnss_rx_resolve_data_dir() → str&#xa;从环境变量或默认路径定位数据根目录"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="440" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="find-latest" value="find_latest_capture(root) → json_path&#xa;按时间戳自动找最新 .json 捕获文件"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="440" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="load-cap" value="load_gnss_rx_capture(json_path)&#xa;  读 .json → meta struct (jsondecode)&#xa;  读 .sc16 → int16[2N] → complex[N×1] double&#xa;→ (samples, meta, paths)"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="440" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="in-types" value="samples: complex[N×1] double&#xa;meta: struct {center_freq, sample_rate, duration_s, samples_captured, prn_id, ...}&#xa;paths: struct {json_path, sc16_path, stem}"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="440" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="plot-overview" value="plot_capture_overview(samples, meta, paths, cfg)&#xa;  ① 时域波形（前 10 ms）&#xa;  ② 65536 pt FFT 功率谱密度&#xa;  ③ IQ 散点图&#xa;→ figures struct"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="440" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="ca-replica" value="[本地 C/A replica 生成]&#xa;generate_ca_code(prn_id)  [MATLAB 内嵌 LFSR 实现]&#xa;np.repeat(ca_code, samples_per_chip) → 重采样到目标采样率"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="695" width="440" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="acquisition" value="run_prn_acquisition(samples, meta, cfg)&#xa;  2D 搜索: Doppler [-10k, +10k] Hz, step=500 Hz&#xa;           码相位 [0, 1022] chips&#xa;  每个 (Doppler, phase): FFT 循环相关&#xa;  非相干累加: 10 ms&#xa;  次峰比 ≥ 2.5 → detected = true&#xa;→ acq_result struct"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="805" width="440" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="acq-out" value="acq_result: struct&#xa;  detected: bool&#xa;  doppler_hz: float&#xa;  code_phase_samples: int&#xa;  peak_ratio: float"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="985" width="440" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== SURVEY BRANCH (Right of main) ===== -->
        <mxCell id="survey" value="run_multi_prn_survey(samples, meta, cfg)&#xa;  for PRN 1~32: run_prn_acquisition(prn_id=k)&#xa;→ survey struct"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="560" y="805" width="360" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="survey-out" value="survey: struct&#xa;  prn_ids: int[32]&#xa;  peak_ratios: float[32]&#xa;  detected: bool[32]"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="560" y="925" width="360" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="plot-survey" value="plot_multi_prn_survey(survey, paths, cfg)&#xa;  次峰比柱状图（PRN 1~32）&#xa;  检测阈值横线 (2.5)&#xa;→ fig handle"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="560" y="1040" width="360" height="80" as="geometry"/>
        </mxCell>

        <!-- Save Artifacts -->
        <mxCell id="save" value="save_analysis_artifacts(meta, paths, figures, acq_result, cfg)&#xa;  PNG 图像 → analysis/&lt;stem&gt;/&#xa;  JSON 结果 → analysis/&lt;stem&gt;/result.json&#xa;  MAT 文件 → analysis/&lt;stem&gt;/workspace.mat&#xa;→ save_info struct"
                style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="880" height="100" as="geometry"/>
        </mxCell>

        <!-- ===== DEPRECATED COLUMN ===== -->
        <mxCell id="dep-bg" value="已废弃函数（保留向后兼容）"
                style="swimlane;startSize=28;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#999999;fontStyle=3;fontSize=11;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="320" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="dep1" value="run_prn1_acquisition(samples, meta, cfg)&#xa;→ 包装 run_prn_acquisition(prn_id=1)&#xa;(deprecated, 仅保留向后兼容)"
                style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#999999;dashed=1;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="1015" y="103" width="290" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== CFG STRUCT ===== -->
        <mxCell id="cfg-bg" value="cfg 配置结构体（可选参数）"
                style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="1000" y="300" width="320" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="cfg-fields" value="save_figures: bool = true&#xa;show_figures: bool = false&#xa;num_coherent_ms: int = 10&#xa;doppler_range_hz: float = 10000&#xa;doppler_step_hz: float = 500&#xa;peak_ratio_threshold: float = 2.5&#xa;prn_ids_to_scan: int[] = 1:32"
                style="text;html=1;fontSize=10;align=left;"
                vertex="1" parent="1">
          <mxGeometry x="1010" y="335" width="300" height="155" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES Main Chain ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="entry" target="resolve-dir" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="resolve-dir" target="find-latest" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="find-latest" target="load-cap" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="load-cap" target="in-types" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="in-types" target="plot-overview" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="in-types" target="ca-replica" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ca-replica" target="acquisition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="acquisition" target="acq-out" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="in-types" target="survey" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="survey" target="survey-out" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="survey-out" target="plot-survey" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="acq-out" target="save" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="plot-survey" target="save" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="plot-overview" target="save" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- deprecated arrow -->
        <mxCell id="e15" value="wraps" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#999999;fontColor=#999999;fontSize=9;" edge="1" source="dep1" target="acquisition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
