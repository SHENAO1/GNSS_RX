                    </mxGeometry>
                </mxCell>

                <!-- acq_result 输入两条链 -->
                <mxCell id="e_acq_ol" value="acq_result" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=2;" parent="1" source="acq" target="ol_3a" edge="1">
                    <mxGeometry relative="1" as="geometry">
