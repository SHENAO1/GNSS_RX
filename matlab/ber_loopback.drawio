<mxfile host="65bd71144e">
    <diagram id="ber-loopback" name="BER Loopback">
        <mxGraphModel dx="2338" dy="862" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- TITLE -->
                <mxCell id="title" value="run_ber_loopback.m：GPS L1 C/A IQ 采集 → 捕获 → 解调 → 误码统计（BER）完整信号处理链路" style="text;html=1;fontStyle=1;fontSize=16;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="15" width="2000" height="30" as="geometry"/>
                </mxCell>

                <!-- ===== TOP ROW ===== -->
                <mxCell id="entry" value="入口 (ber.m → run_ber_loopback.m)&#xa;CAPTURE_PATH · BER_MODE · ACCEL_OPTIONS · TRACKING_OPTIONS&#xa;clearvars / addpath / 解析加速配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="20" y="76" width="340" height="82" as="geometry"/>
                </mxCell>

                <mxCell id="load" value="Step 1: 加载采集数据&#xa;load_gnss_rx_capture(CAPTURE_PATH, precision)&#xa;输出: samples（IQ 复数列）· meta（fs · prn_id 等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="410" y="76" width="310" height="82" as="geometry"/>
                </mxCell>

                <mxCell id="acq" value="Step 2: GPS L1 C/A 捕获&#xa;run_prn_acquisition(前 100ms, meta)&#xa;2D 相关搜索: Doppler × 码相位&#xa;输出: best_doppler_hz · best_code_phase · detected · second_peak_ratio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="770" y="66" width="340" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="truth" value="Step 2.5: TX truth 发现链&#xa;优先级（从高到低）：&#xa;① {stem}_tx_truth.json（sidecar）&#xa;② {stem}.truth.json（sidecar）&#xa;③ {capture_dir}/tx_truth.json&#xa;④ {capture_dir}/ber_truth.json&#xa;⑤ workspace fallback tx_truth.json&#xa;⑥ build_fallback_tx_truth（内置默认 pattern，仅限排障）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="58" width="400" height="196" as="geometry"/>
                </mxCell>

                <!-- ===== STEP 3: OPEN-LOOP CONTAINER ===== -->
                <mxCell id="ol_outer" value="Step 3: Open-loop 诊断基线（recover_nav_bits）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="20" y="283" width="640" height="602" as="geometry"/>
                </mxCell>

                <mxCell id="ol_3a" value="① 逐 1ms 复相关  compute_ms_correlations&#xa;∀k:  corr_ms[k] = Σ { (samples[k] − μ) · PRN · e^{−j2π·f_d·t/fs} }&#xa;输出: corr_ms（复数序列，每 1ms 一个值，幅度=相关强度，相位=残余载波）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="35" y="336" width="610" height="72" as="geometry"/>
                </mxCell>

                <mxCell id="ol_3b" value="② 平方相位法估粗残余频偏（搜索前统一频补）&#xa;sq[k] = corr_ms[k]²      Δφ[k] = angle( sq[k+1] / sq[k] )&#xa;Δf_pre = median(Δφ) / (4π × 1ms)      corr_ms_fcorr = corr_ms · e^{−j2π·Δf_pre·t}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="35" y="426" width="610" height="72" as="geometry"/>
                </mxCell>

                <mxCell id="ol_3c" value="③ 联合枚举搜索  joint_search_with_truth&#xa;遍历: bit_offset ∈ [0..19ms]  ×  pattern_offset ∈ [0..N−1]  ×  polarity ∈ {+1, −1}&#xa;每候选: 20ms 积分 → bit_corr，估 Δf_fine，旋转到实轴，判决 rx_bits = sign(real(·))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="35" y="516" width="610" height="80" as="geometry"/>
                </mxCell>

                <mxCell id="ol_3d" value="④ 多维评分函数（综合四项指标选最优候选）&#xa;score = 1e6 × match_rate  +  1e3 × projection_margin&#xa;        +  10 × bpsk_cluster_strength  +  1e−3 × mean_bit_energy&#xa;ambiguity_flag: top1 与 top2 score 差 &lt; 2e4  或  match_rate 差 &lt; 1%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="35" y="614" width="610" height="84" as="geometry"/>
                </mxCell>

                <mxCell id="ol_3e" value="⑤ 最优候选输出  open_loop_result&#xa;bit_offset_ms · pattern_offset · polarity · rx_bits · ref_bits&#xa;match_rate · ambiguity_flag · score_components · diagnostics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="35" y="716" width="610" height="68" as="geometry"/>
                </mxCell>

                <!-- ===== STEP 4: TRACKED CONTAINER ===== -->
                <mxCell id="tr_outer" value="Step 4: Tracked 主链（track_nav_bits）— 接近真实接收机工作方式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="710" y="283" width="900" height="640" as="geometry"/>
                </mxCell>

                <mxCell id="tr_4a" value="① DLL 码跟踪  track_code_phase_ms（逐 1ms 更新 cursor）&#xa;Prompt = Σ(segment × PRN)    Early = Σ(segment × PRN_{+1chip})    Late = Σ(segment × PRN_{−1chip})&#xa;锁定度 = |P| / (|E| + |L|)    失锁 or 每 100ms 触发局部重搜 → code_reacq events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="725" y="336" width="875" height="80" as="geometry"/>
                </mxCell>

                <mxCell id="tr_4b" value="② FLL-assisted PLL 载波跟踪  track_carrier_from_prompt&#xa;FLL 平滑窗 50ms，估残余 Doppler → PLL 增益 0.08 迭代修正载波相位&#xa;输出: prompt_fll · prompt_pll · fll_freq_hz · pll_phase_deg · phase_error_deg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="725" y="434" width="875" height="72" as="geometry"/>
                </mxCell>

                <mxCell id="tr_4c" value="③ 初始比特对齐  estimate_initial_bit_alignment（在训练段上搜索）&#xa;训练段: 前 2000ms 的 prompt_pll 序列    联合搜索方式同 open-loop（但基于已跟踪的 prompt）&#xa;输出: bit_offset_ms · pattern_offset · polarity · match_rate · ambiguity_flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="725" y="524" width="875" height="80" as="geometry"/>
                </mxCell>

                <mxCell id="tr_4d" value="④ 比特时序稳定性检查  check_bit_timing_stability&#xa;每 1000ms 检查一次（观测窗 2000ms）；边界漂移 → bit_timing_events 重对齐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="725" y="622" width="875" height="62" as="geometry"/>
                </mxCell>

                <mxCell id="tr_4e" value="⑤ 20ms 积分 + BPSK 判决  integrate_bits_from_prompt&#xa;bit_corr[i] = Σ_{20ms} prompt_pll      φ = angle( Σ bit_corr² ) / 2    （BPSK 180° 翻转无关量）&#xa;rx_bits = sign( real( bit_corr × e^{−jφ} ) )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="725" y="702" width="875" height="80" as="geometry"/>
                </mxCell>

                <mxCell id="tr_4f" value="⑥ BER 与滑动窗统计&#xa;ber = mean( sign(rx_bits) ≠ sign(ref_bits) )    window_ber: 滑动 100bit 窗 + bit_lock_quality 掩码过滤失锁段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="725" y="800" width="875" height="62" as="geometry"/>
                </mxCell>

                <!-- ===== BOTTOM ROW ===== -->
                <mxCell id="select" value="Step 5: truth 一致性判决&#xa;BER_MODE=tracked_truth（默认）→ selected = tracked_result&#xa;BER_MODE=open_loop_truth → selected = open_loop_result&#xa;警告: match_rate &lt; 55% 则为 truth mismatch / bit timing 歧义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="50" y="960" width="370" height="86" as="geometry"/>
                </mxCell>

                <mxCell id="ber_stat" value="Step 6: BER 统计&#xa;errors = Σ ( sign(rx_bits[i]) ≠ sign(ref_bits[i]) )&#xa;BER = errors / total_bits&#xa;输出: errors · total_bits · ber" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="480" y="960" width="340" height="86" as="geometry"/>
                </mxCell>

                <mxCell id="plot" value="Step 7: 可视化&#xa;plot_ber_loopback(analysis_result)&#xa;open-loop vs tracked 对比&#xa;锁定质量 · 局部 window BER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="880" y="960" width="280" height="86" as="geometry"/>
                </mxCell>

                <mxCell id="save" value="Step 8: 可选保存 .mat&#xa;ber_loopback_{timestamp}.mat&#xa;truth · meta · acq_result&#xa;selected_result · stage_timings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="960" width="280" height="86" as="geometry"/>
                </mxCell>

                <!-- NOTES -->
                <mxCell id="notes" value="关键约束 &amp; 设计决策&#xa;1. Acquisition 只用前 100ms（ACQ_DURATION_S=0.1）&#xa;2. open-loop 内存不足时可跳过，用占位结构体代替&#xa;3. track_nav_bits 必须提供 truth.nav_bits_pattern_pm1&#xa;4. fallback truth 仅供链路排障，不适合做严格 BER 结论&#xa;5. GPU DLL 批处理：批次内近似用批首 cursor，锁定时漂移→0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1680" y="283" width="470" height="178" as="geometry"/>
                </mxCell>

                <!-- ===== EDGES ===== -->
                <!-- Top flow -->
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="entry" target="load" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="load" target="acq" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- entry → truth (CAPTURE_PATH 用于 sidecar 发现) -->
                <mxCell id="e3" value="CAPTURE_PATH" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=2;" parent="1" source="entry" target="truth" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="190" y="52"/>
