                </mxCell>
                <mxCell id="e_acq_tr" value="acq_result" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=2;" parent="1" source="acq" target="tr_4a" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="940" y="278"/>
                            <mxPoint x="1160" y="278"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- truth_pattern 输入两条链 -->
                <mxCell id="e_truth_ol" value="truth_pattern" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=2;" parent="1" source="truth" target="ol_3c" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1170" y="556"/>
                            <mxPoint x="645" y="556"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_truth_tr" value="truth_pattern" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=2;" parent="1" source="truth" target="tr_4c" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1370" y="283"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- Step 3 内部链 -->
                <mxCell id="e_ol_ab" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="ol_3a" target="ol_3b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_ol_bc" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="ol_3b" target="ol_3c" edge="1">
