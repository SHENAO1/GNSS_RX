<mxfile host="65bd71144e">
    <diagram id="ber-loopback" name="BER Loopback">
        <mxGraphModel dx="2338" dy="862" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="run_ber_loopback.m：采集文件 + TX truth → open-loop 基线 + tracked 主链 → BER 结论" style="text;html=1;fontStyle=1;fontSize=18;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="20" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="entry" value="run_ber_loopback.m&#xa;clearvars / addpath / 解析 CAPTURE_PATH / BER_MODE / ACCEL_OPTIONS / TRACKING_OPTIONS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1">
                    <mxGeometry x="20" y="230" width="330" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="load" value="Step 1&#xa;load_gnss_rx_capture(CAPTURE_PATH, precision)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="460" y="70" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="acq" value="Step 2&#xa;仅取前 100 ms 做 acquisition&#xa;run_prn_acquisition(acq_samples, meta, acq_cfg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="800" y="60" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="truth" value="Step 2.5&#xa;discover_tx_truth_json()&#xa;load_tx_truth_json()&#xa;或 build_fallback_tx_truth()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="230" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="openloop" value="Step 3&#xa;recover_nav_bits(samples, meta, acq_result, truth, accel_options)&#xa;open-loop truth 基线&#xa;内存不足时允许跳过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" parent="1" vertex="1">
                    <mxGeometry x="510" y="510" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="tracked" value="Step 4&#xa;track_nav_bits(samples, meta, acq_result, truth, TRACKING_OPTIONS, accel_options)&#xa;tracking 主链，输出 BER / match_rate / lock metrics / window BER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" parent="1" vertex="1">
                    <mxGeometry x="1350" y="490" width="420" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="select" value="Step 5 + 6&#xa;根据 BER_MODE 在 tracked_truth / open_loop_truth 间选最终结果&#xa;统计 errors / total_bits / ber" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="750" y="690" width="420" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="plot" value="Step 7&#xa;plot_ber_loopback(analysis_result)&#xa;对照 open-loop / tracked / 锁定质量 / 局部 BER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1">
                    <mxGeometry x="810" y="850" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="save" value="Step 8&#xa;可选保存 .mat 结果包&#xa;truth / meta / acq_result / selected_result / analysis_result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="850" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="notes" value="关键约束&#xa;1. acquisition 阶段默认只用前 100 ms，提高速度&#xa;2. tracked 主循环当前固定走 CPU，acquisition/open-loop 才会吃 accel backend&#xa;3. fallback truth 仅适合链路排障，不适合作为严格 BER 结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" parent="1" vertex="1">
