                    </mxGeometry>
                </mxCell>

                <!-- Samples 输入两条链 -->
                <mxCell id="e_load_ol" value="samples" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=2;" parent="1" source="load" target="ol_3a" edge="1">
                    <mxGeometry relative="1" as="geometry">
