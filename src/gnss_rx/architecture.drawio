<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-03-26" version="21.0.0">
  <diagram id="gnss-rx-module" name="gnss_rx/ — RX 核心模块">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="1"
                  pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="gnss_rx/ — RX 核心模块 (runtime.py + capture.py + io.py + synthesis.py)"
                style="text;html=1;fontStyle=1;fontSize=14;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="50" y="10" width="1300" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== LEFT COLUMN: Main Capture Flow ===== -->
        <mxCell id="col-left-title" value="主采集流（硬件）"
                style="text;html=1;fontStyle=1;fontSize=12;align=center;fontColor=#333333;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="360" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="in-yaml" value="输入: YAML 文件路径 (str | Path)&#xa;configs/rx_b210*.yaml"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="320" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="load-cfg" value="load_rx_runtime_config(path) → RxRuntimeConfig&#xa;runtime.py&#xa;调用 load_yaml_file [utils/io.py]"
                style="rounded=1;whiteSpace=wrap;fillColor=#82b366;strokeColor=#4d7a3a;fontColor=#ffffff;fontStyle=1;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="320" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="rx-cfg" value="RxRuntimeConfig  @dataclass(frozen=True)&#xa;──────────────────────────────────&#xa;usrp_addr: str       center_freq: float&#xa;sample_rate: float   duration_s: float&#xa;rx_gain: float|None  antenna: str&#xa;bandwidth: float|None  output_dir: Path&#xa;@property capture_samples: int = int(sr × dur)"
                style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="320" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="validate" value=".validate() → RxRuntimeConfig&#xa;检查参数合法性，失败抛出 ValueError"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="320" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="resolve-paths" value="resolve_capture_paths(root, config)&#xa;→ (sc16_path: Path, json_path: Path)&#xa;build_timestamped_capture_stem(config, when) → str"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="320" height="65" as="geometry"/>
        </mxCell>

        <!-- GNU Radio flow -->
        <mxCell id="gr-bg" value="ZeroIfCaptureTopBlock(gr.top_block)  capture.py"
                style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="320" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="usrp-src" value="uhd.usrp_source  (USRP B210)&#xa;fc32 CPU | sc16 OTW | 4.092 MSPS"
                style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="55" y="670" width="290" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="head" value="blocks.head(capture_samples)&#xa;截断至指定采样数量"
                style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="55" y="740" width="290" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="sc16-sink" value="Sc16CaptureSink(output_path)&#xa;.work(...) → int&#xa;complex_to_sc16_interleaved(samples)&#xa;  clip→×32767→int16 IQ LE&#xa;写 .sc16 文件&#xa;.samples_written: int"
                style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="55" y="800" width="290" height="45" as="geometry"/>
        </mxCell>

        <!-- Outputs -->
        <mxCell id="out-sc16" value="输出: .sc16 文件&#xa;int16 交织 I/Q, Little-Endian"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="895" width="155" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="out-json" value="输出: .json sidecar&#xa;捕获元数据"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="205" y="895" width="155" height="50" as="geometry"/>
        </mxCell>

        <!-- Metadata -->
        <mxCell id="meta" value="build_capture_metadata(config, samples_captured, data_path)&#xa;→ CaptureMetadata (frozen dataclass)&#xa;write_metadata_json(path, metadata)"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="320" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="capture-meta" value="CaptureMetadata  @dataclass(frozen=True)&#xa;────────────────────────────────&#xa;timestamp: str    center_freq: float&#xa;sample_rate: float  duration_s: float&#xa;samples_captured: int  data_path: str&#xa;prn_id: int|None   usrp_addr: str"
                style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="320" height="130" as="geometry"/>
        </mxCell>

        <!-- ===== CENTER COLUMN: Synthetic Data Path ===== -->
        <mxCell id="col-mid-title" value="合成数据旁路（仿真）"
                style="text;html=1;fontStyle=1;fontSize=12;align=center;fontColor=#333333;"
                vertex="1" parent="1">
          <mxGeometry x="450" y="50" width="360" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="synth-bg" value="synthesis.py — 合成信号生成"
                style="swimlane;startSize=28;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=11;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="450" y="85" width="340" height="600" as="geometry"/>
        </mxCell>

        <mxCell id="synth-in" value="输入: gnss_tx.GpsL1CaBpskGenerator&#xa;或 build_multi_sat_replay_samples()"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="465" y="128" width="310" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="synth-signal" value="纯净信号: np.complex64[N]&#xa;（来自 gnss_tx 信号生成模块）"
                style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="465" y="213" width="310" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="add-awgn" value="_add_awgn(signal, snr_db) → np.complex64[N]&#xa;noise_power = signal_power / 10^(snr/10)&#xa;noise = complex AWGN (real + imag)"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="465" y="298" width="310" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="noisy-signal" value="带噪信号: np.complex64[N]&#xa;SNR 可配置"
                style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="465" y="403" width="310" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="write-sc16" value="write_sc16_file(path, samples) → int&#xa;bytes_written&#xa;格式: int16 IQ 交织 Little-Endian"
                style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="465" y="488" width="310" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="synth-out" value="输出: .sc16 + .json (stem 含 '_synthetic')&#xa;与硬件采集格式完全兼容"
                style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="465" y="583" width="310" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== RIGHT COLUMN: Utility Functions ===== -->
        <mxCell id="util-bg" value="工具/诊断函数 (runtime.py + capture.py)"
                style="swimlane;startSize=28;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontStyle=1;fontSize=11;"
                vertex="1" parent="1">
          <mxGeometry x="870" y="85" width="320" height="380" as="geometry"/>
        </mxCell>

        <mxCell id="u1" value="is_uhd_device_available() → bool&#xa;检测是否有可用 UHD 设备"
                style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="885" y="128" width="290" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="u2" value="uhd_find_devices_output() → str&#xa;子进程执行 uhd_find_devices，返回文本"
                style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="885" y="193" width="290" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="u3" value="load_yaml_file(path) → dict[str, Any]&#xa;[来自 utils/io.py]"
                style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="885" y="258" width="290" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="u4" value="complex_to_sc16_interleaved(samples)&#xa;→ np.int16[2N]&#xa;clip(-1,1)→×32767→IQ 交织"
                style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="885" y="323" width="290" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="u5" value="read_sc16_file(path, num_samples) → np.complex64[N]&#xa;反向：int16 IQ → complex64"
                style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="885" y="398" width="290" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES Main Flow ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="in-yaml" target="load-cfg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="load-cfg" target="rx-cfg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="rx-cfg" target="validate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="validate" target="resolve-paths" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="resolve-paths" target="gr-bg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="usrp-src" target="head" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="head" target="sc16-sink" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gr-bg" target="out-sc16" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gr-bg" target="meta" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="meta" target="out-json" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="meta" target="capture-meta" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== EDGES Synthesis Flow ===== -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="synth-in" target="synth-signal" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="synth-signal" target="add-awgn" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="add-awgn" target="noisy-signal" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="noisy-signal" target="write-sc16" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="write-sc16" target="synth-out" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
